# ==============================================================================
# Apex Trade — Environment Configuration Template
# Safe placeholder values only. Never commit real secrets.
# ==============================================================================

# Runtime
NODE_ENV=development
PORT=5000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apex_trade
DB_USER=root
DB_PASSWORD=your_database_password_here

# Authentication (Placeholders reserved for future milestones)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Frontend & CORS
CLIENT_URL=http://localhost:5173

# Email / SMTP
SMTP_HOST=mail.apextrade.name.ng
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@apextrade.name.ng
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Apex Trade <support@apextrade.name.ng>"
